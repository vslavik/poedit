# generated by
# ./generate_build_ninja.py
include $
    build.vars.ninja
rule download
  command = curl $
      --fail $
      --location $
      --retry 5 $
      --retry-all-errors $
      -o $out $
      $url && $
      test $
      "$sha256" = $
      `shasum $
      -a256 $out $
      | cut -f1 $
      -d" "`
  description = $
      Downloading $
      $url...
  pool = console
default 
